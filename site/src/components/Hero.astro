---
import { identity, links } from '../data/profile';
import ExplodedView from './ExplodedView.astro';
---

<section id="top" class="hero">
  <div class="wrap hero-grid">
    <div class="copy">
      <p class="mono eyebrow">
        <span>{identity.title}</span>
        <span aria-hidden="true">·</span>
        <a href={identity.companyUrl} rel="noopener">{identity.company}</a>
        <span aria-hidden="true">·</span>
        <span>{identity.location}</span>
      </p>
      <h1>
        <span class="h1-line">Brendon</span>
        <span class="h1-line">Otto</span>
      </h1>
      <p class="tagline">{identity.tagline}</p>
      <p class="bio measure">{identity.shortBio}</p>
      <div class="ctas">
        <a class="btn btn-primary" href="#story">
          Read my story
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
        </a>
        <a class="btn" href="#work">See my work</a>
      </div>
      <ul class="socials" aria-label="Profiles">
        {links.map((l) => (
          <li>
            <a href={l.href} rel="me noopener">{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="drawing">
      <ExplodedView />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .copy {
    display: grid;
    gap: 1.4rem;
    min-width: 0;
  }

  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .eyebrow a {
    text-decoration-color: var(--line);
  }

  h1 {
    font-size: clamp(3.4rem, 9vw, 6.4rem);
    font-weight: 780;
    font-variation-settings: 'wdth' 118;
    line-height: 0.92;
    letter-spacing: -0.025em;
    display: grid;
  }

  .h1-line:last-child {
    color: var(--accent);
  }

  .tagline {
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-weight: 600;
    font-size: clamp(1.2rem, 2.3vw, 1.55rem);
    line-height: 1.3;
    text-wrap: balance;
    max-width: 30ch;
  }

  .bio {
    color: var(--ink-2);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .socials {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0.9rem 0 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
  }

  .socials a {
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }

  .socials a:hover {
    color: var(--accent);
  }

  .drawing {
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .drawing {
      order: -1;
      justify-content: flex-start;
    }
  }
</style>
