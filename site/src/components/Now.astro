---
import { capabilities } from '../data/profile';
---

<section id="now" class="sheet">
  <div class="wrap">
    <div class="sheet-head">
      <h2>What I do</h2>
      <p class="mono">Sheet 01 · Capabilities</p>
    </div>
    <ol class="cap-list">
      {capabilities.map((c) => (
        <li class="cap">
          <p class="mono code">{c.code}</p>
          <h3>{c.title}</h3>
          <p class="body">{c.body}</p>
          <p class="evidence"><span class="mono">Evidence</span>{c.evidence}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .cap-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .cap {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.5rem;
    padding: 1.4rem 1.4rem 1.5rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 55%, transparent);
    min-width: 0;
  }

  .cap h3 {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .code {
    color: var(--accent);
  }

  .body {
    color: var(--ink-2);
    font-size: 0.97rem;
  }

  .evidence {
    display: grid;
    gap: 0.15rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--line);
    font-size: 0.92rem;
    color: var(--ink);
  }

  @media (max-width: 960px) {
    .cap-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .cap-list {
      grid-template-columns: 1fr;
    }
  }
</style>
