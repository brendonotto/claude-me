---
import { openTo, links } from '../data/profile';

const linkedin = links.find((l) => l.label === 'LinkedIn')!;
const x = links.find((l) => l.label === 'X')!;
---

<section id="contact" class="sheet">
  <div class="wrap contact-grid">
    <div>
      <div class="sheet-head">
        <h2>What I'm open to</h2>
        <p class="mono">Sheet 06 · Contact</p>
      </div>
      <p class="lead measure">{openTo.lead}</p>
      <p class="also measure">{openTo.also}</p>
    </div>
    <div class="channels">
      <p class="mono">Reach me</p>
      <a class="btn btn-primary" href={linkedin.href} rel="me noopener">
        LinkedIn · {linkedin.handle}
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 L13 3 M6 3h7v7" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
      </a>
      <a class="btn" href={x.href} rel="me noopener">X · {x.handle}</a>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
  }

  .lead {
    font-family: var(--display);
    font-variation-settings: 'wdth' 100;
    font-weight: 600;
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    line-height: 1.35;
    text-wrap: balance;
    margin-bottom: 1rem;
  }

  .also {
    color: var(--ink-2);
  }

  .channels {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding: 1.4rem;
    border: 1px solid var(--line);
    background: var(--paper);
  }

  .channels .btn {
    width: 100%;
    justify-content: space-between;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
