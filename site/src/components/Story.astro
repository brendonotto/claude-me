---
import { story, principles, personal } from '../data/profile';
---

<section id="story" class="sheet">
  <div class="wrap">
    <div class="sheet-head">
      <h2>How I got here</h2>
      <p class="mono">Sheet 02 · Story</p>
    </div>
    <div class="story-grid">
      <div class="prose measure">
        {story.map((p) => <p>{p}</p>)}
        <p class="personal">{personal}</p>
      </div>
      <aside class="principles" aria-labelledby="principles-h">
        <h3 id="principles-h" class="mono">How I work</h3>
        <ul>
          {principles.map((p) => (
            <li>
              <strong>{p.title}</strong>
              <span>{p.body}</span>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .story-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .prose {
    display: grid;
    gap: 1.1rem;
    font-size: 1.1rem;
  }

  .prose p:first-child::first-letter {
    font-family: var(--display);
    font-weight: 800;
    font-size: 3.2em;
    line-height: 0.8;
    float: left;
    padding: 0.08em 0.12em 0 0;
    color: var(--accent);
  }

  .personal {
    color: var(--muted);
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
    font-size: 1rem;
  }

  .principles {
    border: 1px solid var(--line);
    background: var(--paper);
    padding: 1.25rem 1.4rem 1.4rem;
    position: sticky;
    top: 80px;
  }

  .principles h3 {
    margin-bottom: 1rem;
    font-family: var(--mono);
    font-weight: 500;
  }

  .principles ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .principles li {
    display: grid;
    gap: 0.15rem;
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    font-size: 0.98rem;
  }

  .principles strong {
    font-weight: 600;
  }

  .principles span {
    color: var(--ink-2);
  }

  @media (max-width: 860px) {
    .story-grid {
      grid-template-columns: 1fr;
    }

    .principles {
      position: static;
    }
  }
</style>
