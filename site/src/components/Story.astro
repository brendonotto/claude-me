---
import { story, principles, personal } from '../data/profile';
---

<section id="story" class="sheet">
  <div class="wrap">
    <div class="sheet-head">
      <h2>How I got here</h2>
      <p class="mono">Sheet 02 · Story</p>
    </div>
    <div class="story-grid">
      <div class="prose measure">
        {story.map((p) => <p>{p}</p>)}
        <p class="personal">{personal}</p>
      </div>
      <div class="side">
      <figure class="portrait">
        <img src="/images/brendon.jpg" alt="Brendon Otto, outdoors in autumn, smiling at the camera" width="460" height="460" loading="lazy" decoding="async" />
        <figcaption class="mono">Fig. 2 · Detail view</figcaption>
      </figure>
      <aside class="principles" aria-labelledby="principles-h">
        <h3 id="principles-h" class="mono">How I work</h3>
        <ul>
          {principles.map((p) => (
            <li>
              <strong>{p.title}</strong>
              <span>{p.body}</span>
            </li>
          ))}
        </ul>
      </aside>
      </div>
    </div>
  </div>
</section>

<style>
  .story-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .prose {
    display: grid;
    gap: 1.1rem;
    font-size: 1.1rem;
  }

  .prose p:first-child::first-letter {
    font-family: var(--display);
    font-weight: 800;
    font-size: 3.2em;
    line-height: 0.8;
    float: left;
    padding: 0.08em 0.12em 0 0;
    color: var(--accent);
  }

  .personal {
    color: var(--muted);
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
    font-size: 1rem;
  }

  .side {
    display: grid;
    gap: 1.25rem;
    position: sticky;
    top: 80px;
  }

  .portrait {
    margin: 0;
    width: min(100%, 260px);
    position: relative;
    display: grid;
    gap: 0.5rem;
  }

  .portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--blue);
    background: var(--paper);
    filter: saturate(0.85);
  }

  /* registration marks, like a detail callout on a sheet */
  .portrait::before,
  .portrait::after {
    content: '';
    position: absolute;
    width: 12px;
    height: 12px;
    border: 0 solid var(--accent);
    pointer-events: none;
  }

  .portrait::before {
    top: -5px;
    left: -5px;
    border-top-width: 2px;
    border-left-width: 2px;
  }

  .portrait::after {
    top: calc(min(100%, 260px) - 7px);
    right: -5px;
    border-bottom-width: 2px;
    border-right-width: 2px;
  }

  .principles {
    border: 1px solid var(--line);
    background: var(--paper);
    padding: 1.25rem 1.4rem 1.4rem;
  }

  .principles h3 {
    margin-bottom: 1rem;
    font-family: var(--mono);
    font-weight: 500;
  }

  .principles ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .principles li {
    display: grid;
    gap: 0.15rem;
    padding-left: 1rem;
    border-left: 2px solid var(--accent);
    font-size: 0.98rem;
  }

  .principles strong {
    font-weight: 600;
  }

  .principles span {
    color: var(--ink-2);
  }

  @media (max-width: 860px) {
    .story-grid {
      grid-template-columns: 1fr;
    }

    .side {
      position: static;
    }
  }
</style>
